  "summaries": [
    {
      "id": 11832,
      "category": "team",
      "content": "Due to the lack of rate limiting on the promo code redemption endpoint, it was possible to enumerate promo codes. The response also leaked metadata about the user, including the country of the user, their name and profile photo.\n\nThanks, @r0t!",
      "updated_at": "2018-11-20T22:23:41.713Z",
      "can_view?": true,
      "can_create?": false,
      "attachments": [],
