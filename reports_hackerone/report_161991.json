  "summaries": [
    {
      "id": 2467,
      "category": "team",
      "content": "To allow documentation pages to provide convenient links to shops' admin pages, requests to `https://www.shopify.com/admin/*` redirect the user to `https://<shop-name>.myshopify.com/admin/*`, where `<shop-name>` is filled in based on the value of the `last_shop` cookie.\n\nBecause input validation was missing, any `last_shop` value would be accepted, thereby allowing an open redirect to any domain.",
      "updated_at": "2016-08-29T15:40:04.533Z",
