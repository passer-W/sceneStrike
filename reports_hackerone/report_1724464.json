  "summaries": [
    {
      "id": 227238,
      "category": "team",
      "content": "The value of the `cd` (check disabled) flag was not correctly validated in DNS-over-HTTPS JSON API requests to cloudflare-dns.com.\nIn result, despite explicitly setting the flag value to `0` or `false` (according to the [Cloudflare 1.1.1.1 documentation](https://developers.cloudflare.com/1.1.1.1/encryption/dns-over-https/make-api-requests/dns-json/)) the DNSSEC verification was not enforced for an unaware end user.\nThe fix was released by Cloudflare Engineering team and the flag in question is now validated properly.",
      "updated_at": "2022-12-12T10:30:31.297Z",
      "can_view?": true,
      "can_create?": false,
