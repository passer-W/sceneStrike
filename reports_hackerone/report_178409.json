  "summaries": [
    {
      "id": 3483,
      "category": "team",
      "content": "A DNS record was found that was pointing to Fastly, but there was no Fastly service configured for this domain. We removed the record because it was not needed any longer. A subdomain takeover was not possible because although there was no service configured, we do have control of any subdomain of rubygems.org so another user would not be able to register it.",
      "updated_at": "2017-03-06T13:46:12.048Z",
