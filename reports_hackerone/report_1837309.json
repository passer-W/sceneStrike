    {
      "id": 294786,
      "category": "team",
      "content": "The researcher found an IDOR in LinkedIn Skill Test functionality which allowed anyone to view the private skill test results of users who failed to earn a badge and also test results of a passed skill test kept private.",
      "updated_at": "2023-05-17T06:30:20.214Z",
