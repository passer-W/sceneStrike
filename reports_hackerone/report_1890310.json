  "summaries": [
    {
      "id": 571663,
      "category": "team",
      "content": "A cross-site request forgery (CSRF) vulnerability was found on a TikTok Shop endpoint, which could have resulted in the arbitrary creation of tickets. We thank @ibrahim0936356 for reporting this to our team",
      "updated_at": "2024-11-05T22:49:56.803Z",
      "can_view?": true,
      "can_create?": false,
      "attachments": [],
      "user": {
        "id": 1287576,
        "username": "tt_sr",
        "name": "Suhana Hyder",
        "bio": "",
        "cleared": false,
        "verified": false,
        "website": null,
        "location": "",
        "created_at": "2020-08-14T21:25:36.459Z",
        "url": "https://hackerone.com/tt_sr",
        "hackerone_triager": false,
