  "summaries": [
    {
      "id": 380861,
      "category": "team",
      "content": "The researcher found a CSRF issue that allowed targeted links (intended and usable only by a single member) to send connection invitations once clicked on without any prompt/intermediary step to confirm such action. Thank you @marvelmaniac for the report!",
      "updated_at": "2023-12-06T17:14:51.052Z",
      "can_view?": true,
      "can_create?": false,
      "attachments": [],
