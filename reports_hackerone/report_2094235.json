  "summaries": [
    {
      "id": 357279,
      "category": "team",
      "content": "When the Node.js policy feature checks the integrity of a resource against a trusted manifest, the application can intercept the operation and return a forged checksum to node's policy implementation, thus effectively disabling the integrity check.\n\nImpacts:\nThis vulnerability affects all users using the experimental policy mechanism in all active release lines: 18.x and, 20.x.\n\nPlease note that at the time this CVE is issued, the policy mechanism is an experimental feature of Node.js.",
      "updated_at": "2023-10-11T21:29:45.003Z",
