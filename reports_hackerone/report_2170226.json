  "summaries": [
    {
      "id": 397987,
      "category": "team",
      "content": "`setuid()` does not affect libuv's internal io_uring operations if initialized before the call to `setuid()`.\nThis allows the process to perform privileged operations despite presumably having dropped such privileges through a call to `setuid()`.\n\nThis vulnerability affects all users using version greater or equal than Node.js 18.18.0, Node.js 20.4.0 and Node.js 21.",
      "updated_at": "2024-01-29T16:31:24.486Z",
