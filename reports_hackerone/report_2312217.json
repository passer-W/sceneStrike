    {
      "id": 394308,
      "category": "team",
      "content": "@alpernae was able to demonstrate that the [Enjin Platform](https://platform.enjin.io)'s GraphQL interface was missing the appropriate CSRF protection when using a session token.",
      "updated_at": "2024-01-19T11:57:40.081Z",
