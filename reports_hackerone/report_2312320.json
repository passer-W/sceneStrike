  "summaries": [
    {
      "id": 394309,
      "category": "team",
      "content": "@alpernae was able to demonstrate that there was no check for email verification, allowing for a user to authenticate into the [Enjin Platform](https://platform.enjin.io) without ever having verified their email address. This has been addressed and it is now impossible for a session to be initiated without email verification being completed.",
      "updated_at": "2024-01-19T12:00:01.384Z",
