  "summaries": [
    {
      "id": 18163,
      "category": "team",
      "content": "It was possible for an attacker to insert another user’s UUID into the userUuid POST parameter when making a request to https://bonjour.uber.com/marketplace/_rpc?rpc=getConsentScreenDetails, allowing them to retrieve personal data from the victim user’s account, as well as the user's mobile auth token, which could allow them to make requests to mobile APIs as the victim.\n\nThanks again, @appsecure_in!",
      "updated_at": "2019-09-09T15:21:09.235Z",
      "can_view?": true,
      "can_create?": false,
